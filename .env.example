# Spring Boot
APP_PORT=8080
SPRING_PROFILES_ACTIVE=evaluation
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=foliolens
POSTGRES_USER=foliolens
POSTGRES_PASSWORD=change-this-password

# Contest dataset
# Default path is ../foliolens-data, relative to compose.yaml.
FOLIOLENS_DATASET_PATH=../foliolens-data
FOLIOLENS_IMPORT_COMPANIES_ON_STARTUP=false
FOLIOLENS_IMPORT_DISCLOSURES_ON_STARTUP=false
FOLIOLENS_IMPORT_DOCUMENTS_ON_STARTUP=false

# Inspect one DART XML document on startup.
FOLIOLENS_PROFILE_XML_STRUCTURE_ON_STARTUP=false
FOLIOLENS_PROFILE_XML_RECEIPT_NO=
FOLIOLENS_PROFILE_XML_FILE_NAME=

# Inspect a limited page of DART XML documents and write a CSV report.
FOLIOLENS_PROFILE_XML_BATCH_ON_STARTUP=false
FOLIOLENS_PROFILE_XML_BATCH_PAGE=0
FOLIOLENS_PROFILE_XML_BATCH_LIMIT=500
FOLIOLENS_PROFILE_XML_BATCH_REPORT_FILE_NAME=xml-structure-profile-page-000.csv
FOLIOLENS_PROFILE_REPORT_DIRECTORY=./reports

# Inspect a limited page of actual HTML disclosure documents.
# Keep the subtype to inspect the 43 facility-investment documents first.
# Set it to an empty value to inspect every HTML document.
FOLIOLENS_PROFILE_HTML_BATCH_ON_STARTUP=false
FOLIOLENS_PROFILE_HTML_BATCH_PAGE=0
FOLIOLENS_PROFILE_HTML_BATCH_LIMIT=50
FOLIOLENS_PROFILE_HTML_BATCH_RAW_SUBTYPE=신규시설투자등
FOLIOLENS_PROFILE_HTML_BATCH_REPORT_FILE_NAME=html-structure-profile-facility-page-000.csv

# Validate all 43 facility HTML documents without changing parse state.
FOLIOLENS_VALIDATE_HTML_PARSING_ON_STARTUP=false
FOLIOLENS_VALIDATE_HTML_PARSING_PAGE=0
FOLIOLENS_VALIDATE_HTML_PARSING_LIMIT=50
FOLIOLENS_VALIDATE_HTML_PARSING_EXPECTED_COUNT=43
FOLIOLENS_VALIDATE_HTML_PARSING_RAW_SUBTYPE=신규시설투자등
FOLIOLENS_VALIDATE_HTML_PARSING_REPORT_FILE_NAME=html-parsing-validation.csv

# Enable only after validation. Uses the configured real database.
FOLIOLENS_PERSIST_HTML_PARSING_ON_STARTUP=false
FOLIOLENS_PERSIST_HTML_PARSING_BATCH_SIZE=10
FOLIOLENS_PERSIST_HTML_PARSING_MAX_DOCUMENTS=43
FOLIOLENS_PERSIST_HTML_PARSING_MAX_FAILURES=5
FOLIOLENS_PERSIST_HTML_PARSING_RAW_SUBTYPE=신규시설투자등

# Persist PENDING DART XML parsing results to PostgreSQL.
FOLIOLENS_PERSIST_XML_PARSING_ON_STARTUP=false
FOLIOLENS_PERSIST_XML_PARSING_LIMIT=50
FOLIOLENS_PERSIST_XML_PARSING_MAX_DOCUMENTS=500
FOLIOLENS_PERSIST_XML_PARSING_MAX_FAILURES=10

# Generate and persist disclosure search chunks
FOLIOLENS_CHUNKING_ON_STARTUP=false
# DART_XML, HTML or PDF. HTML is limited to exchange; PDF to periodic text-only results.
FOLIOLENS_CHUNKING_CONTENT_FORMAT=DART_XML
# Empty means all subtypes. For an HTML pilot use 신규시설투자등.
FOLIOLENS_CHUNKING_RAW_SUBTYPE=
FOLIOLENS_CHUNKING_BATCH_SIZE=10
FOLIOLENS_CHUNKING_MAX_DOCUMENTS=50
FOLIOLENS_CHUNKING_MAX_FAILURES=5

# Minimal PDF text support. Saves PARTIAL parsing results, not reconstructed tables.
# To parse and chunk in one startup, also enable chunking with format=PDF, empty subtype,
# batch-size=1, max-documents=3, max-failures=1. Keep all other import/profile runners off.
FOLIOLENS_PERSIST_PDF_PARSING_ON_STARTUP=false
FOLIOLENS_PERSIST_PDF_PARSING_MAX_DOCUMENTS=3
# CLOVA Studio (HCX) — 키는 발급 시 1회만 노출되므로 즉시 .env에 보관. 절대 커밋 금지
HCX_API_ENABLED=false
HCX_API_KEY=
HCX_MODEL=HCX-005
# 테스트 키는 testapp, 서비스 키로 교체하면 serviceapp
HCX_APP_TYPE=testapp
