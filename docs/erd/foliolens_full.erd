<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE diagram [
<!ATTLIST diagram version CDATA #REQUIRED name CDATA #IMPLIED time CDATA #REQUIRED>
<!ELEMENT diagram (entities, notes, relations)>
<!ELEMENT entities (data-source*)>
<!ELEMENT data-source (entity*)>
<!ATTLIST data-source id CDATA #REQUIRED>
<!ELEMENT entity (path*)>
<!ATTLIST entity id ID #REQUIRED name CDATA #REQUIRED fq-name CDATA #REQUIRED>
<!ELEMENT path EMPTY>
<!ATTLIST path name CDATA #REQUIRED>
<!ELEMENT notes (note*)>
<!ELEMENT note (#PCDATA)>
<!ATTLIST note id ID #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED w CDATA #IMPLIED h CDATA #IMPLIED>
<!ELEMENT relations (relation*)>
<!ELEMENT relation (column*, bend*)>
<!ATTLIST relation name CDATA #REQUIRED fq-name CDATA #REQUIRED type CDATA #IMPLIED pk-ref IDREF #REQUIRED fk-ref IDREF #REQUIRED>
<!ELEMENT column EMPTY>
<!ATTLIST column name CDATA #REQUIRED ref-name CDATA #REQUIRED>
<!ELEMENT bend EMPTY>
<!ATTLIST bend type CDATA #REQUIRED x CDATA #REQUIRED y CDATA #REQUIRED>
]>
